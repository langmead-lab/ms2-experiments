From 1db6f326bdcdf83d23831d5dab8c8eb116a1beae Mon Sep 17 00:00:00 2001
From: Benjamin Langmead <langmea@cs.jhu.edu>
Date: Sun, 1 Nov 2026 09:52:33 -0500
Subject: [PATCH 1/2] Start matching statistics at the first occurrence of the
 last character

The query loops initialize the BWT row with bwt.select(1, c) and the reference pointer with the sample at the start of that row's run. select is zero-based, so this picks the second occurrence of c. When that occurrence lies inside a run rather than at its start, the row and the pointer refer to different suffixes, and the matching statistics computed from that state can be wrong. Selecting occurrence 0 picks the start of the first run of c, so the row and its sample agree. Both the in-memory and file-based query loops are fixed.
---
 include/ms/phoni.hpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/include/ms/phoni.hpp b/include/ms/phoni.hpp
index efa0c69..e5eb365 100644
--- a/include/ms/phoni.hpp
+++ b/include/ms/phoni.hpp
@@ -327,7 +327,7 @@ public:
         DCHECK_GT(this->bwt.number_of_letter(pattern_at(m-1)), 0);
 
         //! Start with the last character
-        auto pos = this->bwt.select(1, pattern_at(m-1));
+        auto pos = this->bwt.select(0, pattern_at(m-1));
         {
             const ri::ulint run_of_j = this->bwt.run_of_position(pos);
             ON_DEBUG(ms_references[m-1] = samples_start[run_of_j]);
@@ -583,7 +583,7 @@ public:
         DCHECK_GT(this->bwt.number_of_letter(pattern_at(m-1)), 0);
 
         //! Start with the last character
-        auto pos = this->bwt.select(1, pattern_at(m-1));
+        auto pos = this->bwt.select(0, pattern_at(m-1));
         {
             const ri::ulint run_of_j = this->bwt.run_of_position(pos);
             ON_DEBUG(ms_references[m-1] = samples_start[run_of_j]);
-- 
