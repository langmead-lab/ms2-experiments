From 900dd24365fa83893f67249625187cab0e74a690 Mon Sep 17 00:00:00 2001
From: Benjamin Langmead <langmea@cs.jhu.edu>
Date: Sun, 1 Nov 2026 09:52:46 -0500
Subject: [PATCH 1/3] Set run1 before computing the succeeding LCE

When rank is 0 there is no preceding occurrence of c, so the query loops call compute_succeeding_lce() right away. That lambda reads samples_start[run1], but run1 was only assigned later, in the branch that compares against the threshold. The rank-0 case therefore read an uninitialized run number, and the resulting matching statistics lengths can be too short. Assign run1 as soon as the succeeding occurrence sa1 is selected, in both the in-memory and file-based query loops.
---
 include/ms/aug_phoni.hpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/include/ms/aug_phoni.hpp b/include/ms/aug_phoni.hpp
index a5876f7..b2c8d9e 100644
--- a/include/ms/aug_phoni.hpp
+++ b/include/ms/aug_phoni.hpp
@@ -367,6 +367,7 @@ public:
 
 				if(rank < number_of_runs_of_c) {
 					sa1 = this->bwt.select(rank, c);
+					run1 = this->bwt.run_of_position(sa1);
 					DCHECK_GT(sa1, pos);
 				}
 
@@ -440,7 +441,6 @@ public:
 					// {
                         // INSERT CHECK HERE
                         // Check thresholds and boundary LCEs first
-                        run1 = this->bwt.run_of_position(sa1);
                         const size_t thr = thresholds[run1];
                         if (pos < thr) // check preceding thr_lce or compute new preceding LCE
                         {
@@ -684,6 +684,7 @@ public:
 
 				if(rank < number_of_runs_of_c) {
 					sa1 = this->bwt.select(rank, c);
+					run1 = this->bwt.run_of_position(sa1);
 					DCHECK_GT(sa1, pos);
 				}
 				
@@ -757,7 +758,6 @@ public:
 					// {
                         // INSERT CHECK HERE
                         // Check thresholds and boundary LCEs first
-                        run1 = this->bwt.run_of_position(sa1);
                         const size_t thr = thresholds[run1];
                         if (pos < thr) // check preceding thr_lce or compute new preceding LCE
                         {
